{
  "name": "octopus-track",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./apps/*\" dev",
    "dev:web": "pnpm --filter @octopus/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:migrate": "pnpm --filter @octopus/db migrate",
    "db:seed": "pnpm --filter @octopus/db seed",
    "simulate": "pnpm --filter @octopus/ingest simulate"
  }
}
