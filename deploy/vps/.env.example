# Copia este archivo a ".env" en esta misma carpeta y rellénalo.
# deploy/vps/setup.sh genera los secretos marcados "(auto)" si los dejas vacíos.

# ---------------------------------------------------------------- dominio / TLS
# Dominio que apunta (registro A) a la IP de esta VPS. Caddy pide el
# certificado TLS automáticamente con este dominio + correo.
DOMAIN=track.tu-dominio.com
ACME_EMAIL=tu-correo@ejemplo.com

# ---------------------------------------------------------------- base de datos
# (auto) generado por setup.sh si lo dejas vacío
DB_PASSWORD=

# ---------------------------------------------------------------- secretos de la app
# Todos (auto) generados por setup.sh si los dejas vacíos.
AUTH_SECRET=
INGEST_TOKEN=
REALTIME_JWT_SECRET=
CRON_SECRET=

# ---------------------------------------------------------------- notificaciones push (opcional)
# Genera el par con:
#   pnpm --filter @octopus/ingest-core exec tsx -e 'import {generateVapidKeys} from "./src/webpush.ts"; console.log(generateVapidKeys())'
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com

# ---------------------------------------------------------------- tráfico en tiempo real en el mapa (opcional)
# Token gratuito de https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_TOKEN=

# ---------------------------------------------------------------- aviso de privacidad / responsable
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_LEGAL_EMAIL=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_LEGAL_COUNTRY=República Dominicana
NEXT_PUBLIC_LEGAL_JURISDICTION=
NEXT_PUBLIC_RETENTION_DAYS=180

# ---------------------------------------------------------------- cuenta inicial
ALLOW_SIGNUP=false
BOOTSTRAP_COMPANY=Octopus Track
BOOTSTRAP_ADMIN_EMAIL=tu-correo@ejemplo.com
# (auto) se obliga a cambiarla al entrar
BOOTSTRAP_ADMIN_PASSWORD=

# ---------------------------------------------------------------- generadas a partir de DOMAIN (no tocar)
NEXT_PUBLIC_REALTIME_URL=wss://${DOMAIN}/realtime
NEXT_PUBLIC_INGEST_HOST=${DOMAIN}
NEXT_PUBLIC_INGEST_TCP_PORT=5023
