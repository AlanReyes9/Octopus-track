# --- Base de datos (PostgreSQL + PostGIS; TimescaleDB opcional) ---
# Supabase: usa el pooler en modo transacción (puerto 6543) y el rol de la app:
# postgres://octopus_app.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgres://octopus:octopus@localhost:5432/octopus

# --- Redis Pub/Sub (opcional en la web; requerido por el gateway realtime) ---
REDIS_URL=redis://localhost:6379

# --- Autenticación web (sesión) ---
AUTH_SECRET=cambia-esto-por-una-cadena-larga-aleatoria

# --- Gateway WebSocket ---
# Secreto compartido entre la web (emite tokens) y apps/realtime (los valida)
REALTIME_JWT_SECRET=otro-secreto-largo-aleatorio
REALTIME_PORT=4001
# URL pública del gateway que usa el navegador. Vacío => la UI usa polling.
NEXT_PUBLIC_REALTIME_URL=ws://localhost:4001

# Registro público de empresas (false = solo el administrador crea usuarios)
ALLOW_SIGNUP=false

# --- Ingesta ---
# Token para /api/ingest/gateway y /api/ingest/osmand (cabecera X-Ingest-Token o ?token=)
INGEST_TOKEN=token-de-ingesta
INGEST_HTTP_PORT=4000
INGEST_TCP_PORT=5023

# --- Comandos a equipos vía servidor de protocolos externo (opcional) ---
COMMANDS_WEBHOOK_URL=
COMMANDS_WEBHOOK_TOKEN=

# --- Datos legales mostrados en /legal/* ---
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_LEGAL_EMAIL=
NEXT_PUBLIC_LEGAL_COUNTRY=México
NEXT_PUBLIC_LEGAL_JURISDICTION=
NEXT_PUBLIC_RETENTION_DAYS=180

# --- Mapa (opcional): estilo MapLibre propio ---
NEXT_PUBLIC_MAP_STYLE_URL=
