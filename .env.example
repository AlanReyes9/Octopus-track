# --- Base de datos (PostgreSQL + TimescaleDB + PostGIS) ---
DATABASE_URL=postgres://octopus:octopus@localhost:5432/octopus

# --- Redis Pub/Sub (opcional en la web; requerido por el gateway realtime) ---
REDIS_URL=redis://localhost:6379

# --- Autenticación web (sesión) ---
AUTH_SECRET=cambia-esto-por-una-cadena-larga-aleatoria

# --- Gateway WebSocket ---
# Secreto compartido entre la web (emite tokens) y apps/realtime (los valida)
REALTIME_JWT_SECRET=otro-secreto-largo-aleatorio
REALTIME_PORT=4001
# URL pública del gateway que usa el navegador. Vacío => la UI usa polling.
NEXT_PUBLIC_REALTIME_URL=ws://localhost:4001

# --- Ingesta ---
# Token que deben enviar los forwarders (Traccar) en el header X-Ingest-Token
INGEST_TOKEN=token-de-ingesta
INGEST_HTTP_PORT=4000
INGEST_TCP_PORT=5023
