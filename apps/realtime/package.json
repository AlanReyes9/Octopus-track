{
  "name": "@octopus/realtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": ["dist"],
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsup src/main.ts --format esm --target node20 --clean --noExternal @octopus/telemetry",
    "start": "node dist/main.js",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@octopus/telemetry": "workspace:*",
    "ioredis": "^5.6.0",
    "jose": "^6.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
