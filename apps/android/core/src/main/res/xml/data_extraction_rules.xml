<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Sin copias de seguridad en la nube ni transferencias: contienen el token de sesión. -->
    <cloud-backup><exclude domain="root" /><exclude domain="sharedpref" /><exclude domain="file" /></cloud-backup>
    <device-transfer><exclude domain="root" /><exclude domain="sharedpref" /><exclude domain="file" /></device-transfer>
</data-extraction-rules>
