<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Pantalla de arranque (Android 12+ y compatibilidad): morado de marca + pulpo -->
    <style name="Theme.Octopus.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/octopus_violet_950</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_octopus</item>
        <item name="postSplashScreenTheme">@style/Theme.Octopus</item>
    </style>

    <style name="Theme.Octopus" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/ic_launcher_background</item>
    </style>
</resources>
